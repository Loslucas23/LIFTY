{
  "name": "@lifty/desktop",
  "productName": "Lifty",
  "version": "0.1.0",
  "private": true,
  "description": "Lifty para la compu: guarda tus datos y sincroniza con el celular.",
  "author": "Lifty",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke-test",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "uy.lifty.app",
    "productName": "Lifty",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Lifty"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "executableName": "lifty"
    },
    "executableName": "lifty"
  }
}
